# Порт сервера (Heroku автоматически устанавливает PORT)
PORT=3001

# Настройки безопасности
NODE_ENV=production

# Настройки CORS (оставьте пустым для разрешения всех доменов)
ALLOWED_ORIGINS=

# Настройки Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# Настройки очистки
MESSAGE_CLEANUP_HOURS=6
USER_CLEANUP_MINUTES=5

# Настройки логирования
LOG_LEVEL=info